# Claude CLI Configuration
CLAUDE_CLI_PATH=claude

# Authentication Method (optional - explicit selection)
# Set this to override auto-detection. Values: cli, api_key, bedrock, vertex
# If not set, auto-detects based on available env vars (ANTHROPIC_API_KEY, etc.)
# CLAUDE_AUTH_METHOD=cli

# API Endpoint Protection (OPTIONAL - separate from Claude auth!)
# This is NOT the Claude/Anthropic API key!
# This protects YOUR server from unauthorized access.
# If not set → anyone can call your API (like running locally without a key)
# If set → every request needs: Authorization: Bearer <your-key>
# API_KEY=your-optional-api-key-here

# Server Configuration
PORT=8000
# Host binding address - use 127.0.0.1 for local-only access, 0.0.0.0 for all interfaces
# CLAUDE_WRAPPER_HOST=0.0.0.0
# Maximum request body size in bytes (default: 10MB)
# MAX_REQUEST_SIZE=10485760

# Timeout Configuration (milliseconds)
MAX_TIMEOUT=600000

# CORS Configuration
CORS_ORIGINS=["*"]

# Model Configuration
# Default Claude model to use when none specified in request
DEFAULT_MODEL=claude-sonnet-4-5-20250929
# Cache TTL for dynamic models list (seconds, default: 3600 = 1 hour)
# MODELS_CACHE_TTL=3600

# Anthropic API Key (OPTIONAL)
# Used for: 1) Direct API auth (if CLAUDE_AUTH_METHOD=api_key)
#           2) Dynamic models fetching at /v1/models (even with CLI auth)
# If not set with CLI auth, /v1/models returns a static fallback list
# ANTHROPIC_API_KEY=sk-ant-your-key-here

# Rate Limiting Configuration
RATE_LIMIT_ENABLED=true
RATE_LIMIT_PER_MINUTE=30
RATE_LIMIT_CHAT_PER_MINUTE=10
RATE_LIMIT_DEBUG_PER_MINUTE=2
RATE_LIMIT_AUTH_PER_MINUTE=10
RATE_LIMIT_SESSION_PER_MINUTE=15
RATE_LIMIT_HEALTH_PER_MINUTE=30